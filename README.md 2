// ─── ML Utilities ─────────────────────────────────────────────────────────────
function shuffle(arr, seed = 42) {
  const a = [...arr];
  let s = seed;
  for (let i = a.length - 1; i > 0; i--) {
    s = (s * 1664525 + 1013904223) & 0xffffffff;
    const j = Math.abs(s) % (i + 1);
    [a[i], a[j]] = [a[j], a[i]];
  }
  return a;
}

function standardScale(data) {
  const n = data[0].length;
  const means = Array(n).fill(0);
  const stds = Array(n).fill(0);
  data.forEach(row => row.forEach((v, i) => (means[i] += v)));
  means.forEach((_, i) => (means[i] /= data.length));
  data.forEach(row => row.forEach((v, i) => (stds[i] += (v - means[i]) ** 2)));
  stds.forEach((_, i) => (stds[i] = Math.sqrt(stds[i] / data.length)));
  return { scaled: data.map(row => row.map((v, i) => (v - means[i]) / stds[i])), means, stds };
}

function euclidean(a, b) {
  return Math.sqrt(a.reduce((s, v, i) => s + (v - b[i]) ** 2, 0));
}

function knnPredict(trainX, trainY, testX, k) {
  return testX.map(point => {
    const dists = trainX.map((tr, i) => ({ d: euclidean(point, tr), label: trainY[i] }));
    dists.sort((a, b) => a.d - b.d);
    const neighbors = dists.slice(0, k);
    const votes = [0, 0, 0];
    neighbors.forEach(n => votes[n.label]++);
    return votes.indexOf(Math.max(...votes));
  });
}

function f1Score(y_true, y_pred, numClasses) {
  const scores = [];
  for (let c = 0; c < numClasses; c++) {
    const tp = y_true.filter((v, i) => v === c && y_pred[i] === c).length;
    const fp = y_pred.filter((v, i) => v === c && y_true[i] !== c).length;
    const fn = y_true.filter((v, i) => v === c && y_pred[i] !== c).length;
    const p = tp + fp === 0 ? 0 : tp / (tp + fp);
    const r = tp + fn === 0 ? 0 : tp / (tp + fn);
    scores.push(p + r === 0 ? 0 : (2 * p * r) / (p + r));
  }
  return scores.reduce((a, b) => a + b, 0) / numClasses;
}

function confusionMatrix(y_true, y_pred, n) {
  const m = Array.from({ length: n }, () => Array(n).fill(0));
  y_true.forEach((v, i) => m[v][y_pred[i]]++);
  return m;
}

function runPipeline(k, testRatio, seed) {
  const shuffled = shuffle(RAW_DATA, seed);
  const features = shuffled.map(r => r.slice(0, 4));
  const labels = shuffled.map(r => r[4]);
  const splitIdx = Math.floor(features.length * (1 - testRatio));
  const trainX_raw = features.slice(0, splitIdx);
  const testX_raw = features.slice(splitIdx);
  const trainY = labels.slice(0, splitIdx);
  const testY = labels.slice(splitIdx);
  const { scaled: trainX, means, stds } = standardScale(trainX_raw);
  const testX = testX_raw.map(row => row.map((v, i) => (v - means[i]) / stds[i]));
  const predictions = knnPredict(trainX, trainY, testX, k);
  const accuracy = predictions.filter((p, i) => p === testY[i]).length / testY.length;
  const f1 = f1Score(testY, predictions, 3);
  const cm = confusionMatrix(testY, predictions, 3);
  return { accuracy, f1, cm, testY, predictions, trainSize: splitIdx, testSize: testX.length };
}

// ─── Components ───────────────────────────────────────────────────────────────
function AnimatedNumber({ value, decimals = 1, suffix = "%" }) {
  const [display, setDisplay] = useState(0);
  useEffect(() => {
    let start = 0;
    const end = value;
    const duration = 800;
    const step = 16;
    const increment = (end - start) / (duration / step);
    const timer = setInterval(() => {
      start += increment;
      if (start >= end) { setDisplay(end); clearInterval(timer); }
      else setDisplay(start);
    }, step);
    return () => clearInterval(timer);
  }, [value]);
  return <span>{(display * (suffix === "%" ? 100 : 1)).toFixed(decimals)}{suffix}</span>;
}

