        </div>
        <div style={{ marginBottom: "16px" }}>
          <div style={{ display: "flex", justifyContent: "space-between", marginBottom: "8px" }}>
            <span style={{ fontSize: "11px", color: "rgba(255,255,255,0.5)" }}>Random Seed</span>
            <span style={{ fontSize: "13px", color: "#ff6b35", fontWeight: 700 }}>{seed}</span>
          </div>
          <input type="range" min="1" max="200" value={seed} onChange={e => setSeed(+e.target.value)} style={{ width: "100%" }} />
        </div>
        <button className="run-btn" onClick={handleRun} disabled={running}>
          {running ? "▶ TRAINING..." : "▶ RUN PIPELINE"}
        </button>
      </div>

      {/* Pipeline Steps */}
      <div className="card" style={{ marginBottom: "16px" }}>
        <div style={{ fontSize: "10px", letterSpacing: "0.2em", color: "rgba(255,255,255,0.4)", marginBottom: "16px" }}>
          PIPELINE STATUS
        </div>
        {PIPELINE_STEPS.map((s, i) => {
          const done = step > i;
          const active = step === i && running;
          return (
            <div key={i} style={{
              display: "flex", alignItems: "center", gap: "12px",
              padding: "10px 0",
              borderBottom: i < 4 ? "1px solid rgba(255,255,255,0.05)" : "none",
              opacity: step === 0 && !running ? 0.4 : done ? 1 : active ? 1 : 0.35,
              transition: "all 0.3s",
            }}>
              <div style={{
                width: "32px", height: "32px", borderRadius: "8px",
                background: done ? "rgba(0,212,170,0.15)" : active ? "rgba(123,97,255,0.2)" : "rgba(255,255,255,0.04)",
                border: `1px solid ${done ? "rgba(0,212,170,0.4)" : active ? "rgba(123,97,255,0.5)" : "rgba(255,255,255,0.08)"}`,
                display: "flex", alignItems: "center", justifyContent: "center",
                fontSize: "14px", color: done ? "#00d4aa" : active ? "#7b61ff" : "rgba(255,255,255,0.3)",
                transition: "all 0.3s",
              }}>
                {done ? "✓" : s.icon}
              </div>
              <div style={{ flex: 1 }}>
                <div style={{ fontSize: "12px", fontWeight: 700, color: done ? "#e8e8f0" : "rgba(255,255,255,0.5)" }}>
                  {s.label}
                </div>
                <div style={{ fontSize: "10px", color: "rgba(255,255,255,0.3)", marginTop: "2px" }}>{s.desc}</div>
              </div>
              {active && (
                <div style={{ width: "16px", height: "16px", border: "2px solid #7b61ff", borderTopColor: "transparent", borderRadius: "50%", animation: "spin 0.8s linear infinite" }} />
              )}
            </div>
          );
        })}
      </div>

      {/* Results */}
      {result && (
        <div style={{ animation: "fadeIn 0.5s ease" }}>
          <style>{`@keyframes fadeIn { from { opacity:0; transform:translateY(10px); } to { opacity:1; transform:none; } } @keyframes spin { to { transform: rotate(360deg); } }`}</style>

          {/* Metrics */}
          <div style={{ display: "grid", gridTemplateColumns: "1fr 1fr 1fr", gap: "10px", marginBottom: "16px" }}>
            {[
              { label: "ACCURACY", value: result.accuracy, color: "#00d4aa", decimals: 1, suffix: "%" },
              { label: "F1 SCORE", value: result.f1, color: "#7b61ff", decimals: 3, suffix: "" },
              { label: "TEST SAMPLES", value: result.testSize, color: "#ff6b35", decimals: 0, suffix: "" },
            ].map((m, i) => (
              <div className="metric-card" key={i}>
                <div style={{ fontSize: "9px", letterSpacing: "0.15em", color: "rgba(255,255,255,0.35)", marginBottom: "6px" }}>{m.label}</div>
                <div style={{ fontSize: "20px", fontWeight: 700, color: m.color }}>
                  <AnimatedNumber value={m.value} decimals={m.decimals} suffix={m.suffix} />
                </div>
              </div>
            ))}
          </div>

          {/* Tabs */}
          <div className="card">
            <div style={{ display: "flex", gap: "4px", marginBottom: "16px", borderBottom: "1px solid rgba(255,255,255,0.06)", paddingBottom: "12px" }}>
              {[
                { id: "matrix", label: "CONF. MATRIX" },
                { id: "kchart", label: "K ANALYSIS" },
                { id: "samples", label: "PREDICTIONS" },
              ].map(t => (
                <button key={t.id} className={`tab-btn ${activeTab === t.id ? "active" : ""}`}
                  onClick={() => setActiveTab(t.id)}>
                  {t.label}
                </button>
              ))}
            </div>

            {activeTab === "matrix" && (
              <div>
                <div style={{ fontSize: "10px", color: "rgba(255,255,255,0.35)", marginBottom: "12px", letterSpacing: "0.1em" }}>
                  PREDICTED →  /  ACTUAL ↓
                </div>
                <ConfusionMatrixViz cm={result.cm} />
                <div style={{ marginTop: "16px", display: "grid", gridTemplateColumns: "1fr 1fr", gap: "8px" }}>
                  {[
                    { label: "True Positive", color: "#00d4aa", desc: "Correct predictions (diagonal)" },
                    { label: "False Positive", color: "#ff6b35", desc: "Type I error (false alarm)" },
                  ].map((item, i) => (
                    <div key={i} style={{ padding: "8px 10px", borderRadius: "6px", background: "rgba(255,255,255,0.03)", border: "1px solid rgba(255,255,255,0.06)" }}>
                      <div style={{ fontSize: "10px", color: item.color, fontWeight: 700, letterSpacing: "0.1em" }}>{item.label}</div>
                      <div style={{ fontSize: "9px", color: "rgba(255,255,255,0.3)", marginTop: "2px" }}>{item.desc}</div>
                    </div>
                  ))}
                </div>
              </div>
            )}

            {activeTab === "kchart" && (
              <div>
                <div style={{ fontSize: "10px", color: "rgba(255,255,255,0.35)", marginBottom: "12px", letterSpacing: "0.1em" }}>
                  ACCURACY VS K VALUE (test_ratio={Math.round(testRatio * 100)}%)
                </div>
                <KValueChart results={kChart} />
                <div style={{ marginTop: "12px", fontSize: "10px", color: "rgba(255,255,255,0.35)", lineHeight: 1.6 }}>
                  <span style={{ color: "#7b61ff" }}>K=1</span> → overfitting (noise sensitivity)<br />
                  <span style={{ color: "#00d4aa" }}>Optimal K</span> → lowest test error (elbow point)<br />
                  <span style={{ color: "rgba(255,255,255,0.4)" }}>High K</span> → underfitting (generic predictions)
                </div>
              </div>
            )}

            {activeTab === "samples" && (
              <div>
                <div style={{ fontSize: "10px", color: "rgba(255,255,255,0.35)", marginBottom: "12px", letterSpacing: "0.1em" }}>
                  SAMPLE PREDICTIONS (first 20 test items)
                </div>
                <div style={{ display: "grid", gap: "4px" }}>
                  {result.testY.slice(0, 20).map((actual, i) => {
                    const pred = result.predictions[i];
                    const correct = actual === pred;
                    return (
                      <div key={i} style={{
                        display: "grid", gridTemplateColumns: "24px 1fr 1fr 24px",
                        alignItems: "center", gap: "8px",
                        padding: "6px 8px", borderRadius: "6px",
                        background: correct ? "rgba(0,212,170,0.05)" : "rgba(255,107,53,0.08)",
                        border: `1px solid ${correct ? "rgba(0,212,170,0.15)" : "rgba(255,107,53,0.2)"}`,
                        fontSize: "10px",
                      }}>
                        <div style={{ color: "rgba(255,255,255,0.25)", textAlign: "center" }}>{i + 1}</div>
                        <div>
                          <span style={{ color: "rgba(255,255,255,0.4)" }}>ACTUAL: </span>
                          <span style={{ color: CLASS_COLORS[actual], fontWeight: 700 }}>{CLASS_NAMES[actual]}</span>
                        </div>
                        <div>
                          <span style={{ color: "rgba(255,255,255,0.4)" }}>PRED: </span>
                          <span style={{ color: CLASS_COLORS[pred], fontWeight: 700 }}>{CLASS_NAMES[pred]}</span>
                        </div>
                        <div style={{ textAlign: "center", fontSize: "12px" }}>{correct ? "✓" : "✗"}</div>
                      </div>
                    );
                  })}
                </div>
              </div>
            )}
          </div>
        </div>
      )}

      {!result && !running && (
        <div style={{ textAlign: "center", padding: "32px 0", color: "rgba(255,255,255,0.2)", fontSize: "11px", letterSpacing: "0.1em" }}>
          CONFIGURE PARAMETERS · PRESS RUN PIPELINE
        </div>
      )}

      {/* Footer */}
      <div style={{ textAlign: "center", marginTop: "24px", fontSize: "9px", color: "rgba(255,255,255,0.15)", letterSpacing: "0.15em" }}>
        DECODELABS INDUSTRIAL TRAINING KIT · BATCH 2026
      </div>
    </div>
  );
}
