function KValueChart({ results }) {
  const max = Math.max(...results.map(r => r.acc));
  const min = Math.min(...results.map(r => r.acc));
  const h = 80;
  const w = 260;
  const pts = results.map((r, i) => {
    const x = (i / (results.length - 1)) * w;
    const y = h - ((r.acc - min + 0.01) / (max - min + 0.02)) * h;
    return { x, y, r };
  });
  const optimal = results.reduce((best, r) => r.acc > best.acc ? r : best, results[0]);

  return (
    <div>
      <svg width={w + 20} height={h + 30} style={{ overflow: "visible" }}>
        <defs>
          <linearGradient id="lineGrad" x1="0" y1="0" x2="1" y2="0">
            <stop offset="0%" stopColor="#7b61ff" />
            <stop offset="100%" stopColor="#00d4aa" />
          </linearGradient>
        </defs>
        <polyline
          points={pts.map(p => `${p.x + 10},${p.y}`).join(" ")}
          fill="none" stroke="url(#lineGrad)" strokeWidth="2.5" strokeLinejoin="round"
        />
        {pts.map((p, i) => (
          <g key={i}>
            <circle cx={p.x + 10} cy={p.y} r={results[i].k === optimal.k ? 6 : 3.5}
              fill={results[i].k === optimal.k ? "#00d4aa" : "#7b61ff"}
              stroke={results[i].k === optimal.k ? "rgba(0,212,170,0.4)" : "none"}
              strokeWidth="4"
            />
            {results[i].k === optimal.k && (
              <text x={p.x + 10} y={p.y - 12} textAnchor="middle" fill="#00d4aa" fontSize="9" fontFamily="Space Mono">
                BEST K={results[i].k}
              </text>
            )}
          </g>
        ))}
        {[1, 5, 10, 15, 20].map(k => {
          const idx = results.findIndex(r => r.k === k);
          if (idx < 0) return null;
          const x = (idx / (results.length - 1)) * w + 10;
          return (
            <text key={k} x={x} y={h + 22} textAnchor="middle" fill="rgba(255,255,255,0.3)" fontSize="9" fontFamily="Space Mono">
              {k}
            </text>
          );
        })}
        <text x={10 + w / 2} y={h + 32} textAnchor="middle" fill="rgba(255,255,255,0.3)" fontSize="9" fontFamily="Space Mono">K VALUE</text>
      </svg>
    </div>
  );
}

